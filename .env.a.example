# ============================================================
# 公司 A — 完整環境設定
# 複製為 .env.a 後填入實際值
# ============================================================

# Docker Compose project name（自動建立隔離 network）
COMPOSE_PROJECT_NAME=iface-a

# ── MSSQL 連線（iface-db + iface-initdb 共用）──────────────
IFACE_SERVER=192.168.101.204\INSTANCE_A
IFACE_USER=mis
IFACE_PWD=your_password
IFACE_DB=IFACE

# ── EIP 電商平台 ─────────────────────────────────────────────
EIP_CONFIG=config/eip.yml
EIP_BASE_URL=https://api-eip.speeding-rocket.com
EIP_MODULE=EIP
EIP_ACCESS_KEY=your_eip_access_key

# ── RETEX POS ────────────────────────────────────────────────
RETEX_BASE_URL=http://pos.speeding-rocket.io:82
RETEX_TOKEN=
RETEX_API_KEY=
RETEX_API_IV=
RETEX_SALT_KEY=

# ── xdelivery ────────────────────────────────────────────────
XDELIVERY_ACCESS_KEY=your_xdelivery_key
XDELIVERY_MERCHANT_ID=1
XDELIVERY_MERCHANT_NAME=光速火箭有限公司

# ── 對外 port（選用，搭配 docker-compose.ports.yml 使用）────
# 預設 iface-db 不對外開放，僅 Docker network 內部存取。
# 需要 Swagger UI 或外部 API 存取時取消註解：
# IFACE_DB_PORT=8100

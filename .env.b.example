# ============================================================
# 公司 B（EIP LL）— 完整環境設定
# 複製為 .env.b 後填入實際值
# ============================================================

# Docker Compose project name（自動建立隔離 network）
COMPOSE_PROJECT_NAME=iface-b

# ── MSSQL 連線（iface-db + iface-initdb 共用）──────────────
IFACE_SERVER=192.168.101.204\INSTANCE_B
IFACE_USER=mis
IFACE_PWD=your_password
IFACE_DB=IFACE

# ── EIP LL 電商平台 ──────────────────────────────────────────
EIP_CONFIG=config/eipll.yml
EIP_BASE_URL=https://api.jessetang.eips.app
EIP_MODULE=LLEIP
EIP_ACCESS_KEY=your_ll_access_key

# ── RETEX POS（公司 B 不使用，留空）────────────────────────
RETEX_BASE_URL=
RETEX_TOKEN=
RETEX_API_KEY=
RETEX_API_IV=
RETEX_SALT_KEY=

# ── xdelivery（公司 B 不使用，留空）────────────────────────
XDELIVERY_ACCESS_KEY=
XDELIVERY_MERCHANT_ID=
XDELIVERY_MERCHANT_NAME=

# ── 對外 port（選用，搭配 docker-compose.ports.yml 使用）────
# IFACE_DB_PORT=8101
